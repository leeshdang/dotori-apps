{
  "name": "dotori-acorn-storage",
  "productName": "Dotori Acorn Storage",
  "version": "1.0.0",
  "description": "Dotori Acorn Storage - squirrel acorn merge puzzle",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "author": "leeshdang@gmail.com",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/update-version.cjs",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "cap:sync": "npx cap sync android",
    "build:apk": "npm run build && npx cap sync android && node scripts/build-apk.cjs",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:win:portable": "npm run build && electron-builder --win zip --x64",
    "dist:linux": "npm run build && electron-builder --linux AppImage tar.gz --x64"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.dotori.acornstorage",
    "productName": "Dotori Acorn Storage",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "build/icon.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "ko_KR",
        "en_US",
        "ja_JP",
        "zh_CN"
      ],
      "language": 1042,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Dotori-AcornStorage-win-x64.exe"
    },
    "portable": {
      "artifactName": "Dotori-AcornStorage-portable.zip"
    },
    "linux": {
      "target": "AppImage",
      "artifactName": "Dotori-AcornStorage-linux.AppImage"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3"
  }
}